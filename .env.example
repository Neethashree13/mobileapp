# ==========================================
# FlashCart AI - Environment Configurations
# ==========================================

# Port on which the API gateway listens
PORT=3000

# Server execution lifecycle ('development' or 'production')
NODE_ENV=development

# --- PostgreSQL Relational Database Credentials ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=flashcart_db
PGUSER=postgres
PGPASSWORD=root

# --- Google Gemini Large Language Model Key ---
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Firebase Client & Cloud Push Core Channel ---
# Sourced from your Firebase Console settings
FIREBASE_PROJECT_ID=flashcart-ai-prod
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/firebase-service-account-key.json

# --- JWT Session Secrets ---
JWT_SECRET=super_secret_jwt_key_for_flashcart_ai
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_for_flashcart_ai

