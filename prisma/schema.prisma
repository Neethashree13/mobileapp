// Prisma Schema for FlashCart AI - Module 1: Authentication

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  DELIVERY_PARTNER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  OTP
  FIREBASE
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  phone         String?        @unique
  phoneNumber   String?        @map("phone_number")
  passwordHash  String?        @map("password_hash")
  firstName     String         @map("first_name")
  lastName      String?        @map("last_name")
  firebaseUid   String?        @unique @map("firebase_uid")
  profilePhoto  String?        @map("profile_photo")
  profileImage  String?        @map("profile_image")
  gender        String?        @default("unspecified")
  role          Role           @default(USER)
  authProvider  AuthProvider   @default(LOCAL) @map("auth_provider")
  isVerified    Boolean        @default(true) @map("is_verified")
  isActive      Boolean        @default(true) @map("is_active")
  walletBalance Decimal        @default(1200.00) @map("wallet_balance") @db.Decimal(10, 2)
  streakCount   Int            @default(1) @map("streak_count")
  lastLogin     DateTime?      @map("last_login")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  sessions      UserSession[]
  loginHistory  LoginHistory[]
  auditLogs     AuditLog[]
  addresses     Address[]
  preferences   UserPreferences?
  settings      UserSettings?
  referrals     Referral[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model Address {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String   @default("Home")
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  houseNo      String?  @map("house_no")
  apartment    String?
  street       String?
  landmark     String?
  city         String
  state        String
  country      String   @default("India")
  pincode      String?
  postalCode   String?  @map("postal_code")
  latitude     Float
  longitude    Float
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model UserPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  emailNotifications    Boolean  @default(true) @map("email_notifications")
  pushNotifications     Boolean  @default(true) @map("push_notifications")
  smsNotifications      Boolean  @default(false) @map("sms_notifications")
  promotionalAlerts     Boolean  @default(true) @map("promotional_alerts")
  orderUpdates          Boolean  @default(true) @map("order_updates")
  deliveryAlerts        Boolean  @default(true) @map("delivery_alerts")
  language              String   @default("English (US)")
  dietary               String[] @default([])
  shareDataWithPartners Boolean  @default(false) @map("share_data_with_partners")
  personalizedAds       Boolean  @default(true) @map("personalized_ads")
  locationTracking      Boolean  @default(true) @map("location_tracking")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSettings {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  isDarkMode        Boolean  @default(false) @map("is_dark_mode")
  biometricsEnabled Boolean  @default(true) @map("biometrics_enabled")
  cacheSizeMb       Int      @default(42) @map("cache_size_mb")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Referral {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  referralCode String   @unique @map("referral_code")
  referredBy   String?  @map("referred_by")
  rewardPoints Int      @default(0) @map("reward_points")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referralCode])
  @@map("referrals")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  actionType String   @map("action_type")
  details    String
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activity_logs")
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  deviceId      String?   @map("device_id")
  deviceName    String?   @map("device_name")
  refreshToken  String    @unique @map("refresh_token")
  ipAddress     String?   @map("ip_address")
  isRememberMe  Boolean   @default(false) @map("is_remember_me")
  expiresAt     DateTime  @map("expires_at")
  loginTime     DateTime  @default(now()) @map("login_time")
  logoutTime    DateTime? @map("logout_time")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("user_sessions")
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_verifications")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ipAddress String   @map("ip_address")
  deviceInfo String  @map("device_info")
  status    String   @default("success")
  loginTime DateTime @default(now()) @map("login_time")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_history")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  details   String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model Category {
  id            String        @id
  name          String        @unique
  iconName      String        @map("icon_name")
  colorHex      String        @map("color_hex")
  imageUrl      String?       @map("image_url")
  isActive      Boolean       @default(true) @map("is_active")
  sortOrder     Int           @default(0) @map("sort_order")
  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id         String    @id
  categoryId String    @map("category_id")
  name       String
  slug       String
  imageUrl   String?   @map("image_url")
  isActive   Boolean   @default(true) @map("is_active")
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@map("subcategories")
}

model Brand {
  id          String    @id
  name        String    @unique
  slug        String
  logoUrl     String?   @map("logo_url")
  description String?
  isFeatured  Boolean   @default(false) @map("is_featured")
  isActive    Boolean   @default(true) @map("is_active")
  products    Product[]

  @@map("brands")
}

model Product {
  id               String                 @id
  name             String
  slug             String?
  categoryId       String                 @map("category_id")
  subcategoryId    String?                @map("subcategory_id")
  brandId          String?                @map("brand_id")
  price            Decimal                @db.Decimal(10, 2)
  originalPrice    Decimal?               @map("original_price") @db.Decimal(10, 2)
  unit             String
  imageUrl         String                 @map("image_url")
  rating           Decimal                @default(5.00) @db.Decimal(3, 2)
  reviewsCount     Int                    @default(0) @map("reviews_count")
  calories         Int                    @default(0)
  proteinG         Decimal                @default(0.00) @map("protein_g") @db.Decimal(6, 2)
  isOrganic        Boolean                @default(false) @map("is_organic")
  isHealthy        Boolean                @default(false) @map("is_healthy")
  isFeatured       Boolean                @default(false) @map("is_featured")
  isTrending       Boolean                @default(false) @map("is_trending")
  isBestSeller     Boolean                @default(false) @map("is_best_seller")
  isFlashDeal      Boolean                @default(false) @map("is_flash_deal")
  ecoScore         String                 @default("B") @map("eco_score")
  carbonEmissionKg Decimal                @default(0.000) @map("carbon_emission_kg") @db.Decimal(6, 3)
  inventoryCount   Int                    @default(0) @map("inventory_count")
  deliveryTimeMins Int                    @default(10) @map("delivery_time_mins")
  description      String?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  category         Category               @relation(fields: [categoryId], references: [id])
  subcategory      Subcategory?           @relation(fields: [subcategoryId], references: [id])
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  attributes       ProductAttribute[]
  nutrition        ProductNutrition?
  discounts        ProductDiscount[]
  tags             ProductTag[]
  storeInventories StoreInventory[]
  stockMovements   StockMovement[]
  recentlyViewed   RecentlyViewedProduct[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id             String           @id
  productId      String           @map("product_id")
  sku            String           @unique
  name           String
  attributeValues Json?           @map("attribute_values")
  price          Decimal          @db.Decimal(10, 2)
  originalPrice  Decimal?         @map("original_price") @db.Decimal(10, 2)
  inventoryCount Int              @default(0) @map("inventory_count")
  isDefault      Boolean          @default(false) @map("is_default")
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeInventory StoreInventory[]
  stockMovements StockMovement[]

  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  imageUrl     String   @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductAttribute {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  attrKey   String  @map("attr_key")
  attrValue String  @map("attr_value")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_attributes")
}

model ProductNutrition {
  id        String  @id @default(uuid())
  productId String  @unique @map("product_id")
  calories  Int     @default(0)
  proteinG  Decimal @default(0.00) @map("protein_g") @db.Decimal(6, 2)
  fatG      Decimal @default(0.00) @map("fat_g") @db.Decimal(6, 2)
  carbsG    Decimal @default(0.00) @map("carbs_g") @db.Decimal(6, 2)
  fiberG    Decimal @default(0.00) @map("fiber_g") @db.Decimal(6, 2)
  sugarG    Decimal @default(0.00) @map("sugar_g") @db.Decimal(6, 2)
  sodiumMg  Decimal @default(0.00) @map("sodium_mg") @db.Decimal(6, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_nutrition")
}

model ProductDiscount {
  id            String    @id @default(uuid())
  productId     String    @map("product_id")
  discountType  String    @default("percentage") @map("discount_type")
  discountValue Decimal   @map("discount_value") @db.Decimal(10, 2)
  startDate     DateTime? @default(now()) @map("start_date")
  endDate       DateTime? @map("end_date")
  isActive      Boolean   @default(true) @map("is_active")
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_discounts")
}

model ProductTag {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  tagName   String  @map("tag_name")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_tags")
}

model Warehouse {
  id         String      @id
  name       String
  code       String      @unique
  address    String
  city       String
  state      String
  postalCode String      @map("postal_code")
  darkStores DarkStore[]

  @@map("warehouses")
}

model DarkStore {
  id             String           @id
  warehouseId    String?          @map("warehouse_id")
  name           String
  code           String           @unique
  latitude       Float
  longitude      Float
  address        String
  isActive       Boolean          @default(true) @map("is_active")
  warehouse      Warehouse?       @relation(fields: [warehouseId], references: [id])
  inventories    StoreInventory[]
  stockMovements StockMovement[]

  @@map("dark_stores")
}

model StoreInventory {
  id                String          @id @default(uuid())
  storeId           String          @map("store_id")
  productId         String          @map("product_id")
  variantId         String?         @map("variant_id")
  stockQuantity     Int             @default(0) @map("stock_quantity")
  lowStockThreshold Int             @default(10) @map("low_stock_threshold")
  isAvailable       Boolean         @default(true) @map("is_available")
  store             DarkStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, variantId])
  @@map("store_inventory")
}

model StockMovement {
  id           String          @id @default(uuid())
  storeId      String          @map("store_id")
  productId    String          @map("product_id")
  variantId    String?         @map("variant_id")
  movementType String          @map("movement_type")
  quantity     Int
  reason       String?
  notes        String?
  createdBy    String?         @default("System") @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  store        DarkStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model RecentlyViewedProduct {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("recently_viewed_products")
}

